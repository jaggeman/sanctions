# Local development environment variables.
#
# IMPORTANT — Firebase deploy semantics: the Firebase CLI reads dotenv files
# from this directory and injects their contents as env vars on the DEPLOYED
# Cloud Function:
#   .env                    -> deployed to every project
#   .env.<firebase-project> -> deployed only to that specific project
#   .env.local              -> NEVER deployed, local/emulator use only
#
# A security incident (2026-08-16) shipped NODE_ENV=development to the live
# sanctions-app-dev-01 deployment via a bare root `.env`, silently activating
# the hardcoded dev test-login (src/auth/testAccount.ts) in production. Use
# `.env.local` for anything that must never reach a real deployment — copy
# this file to `.env.local`, not `.env`, and fill in real values there.

NODE_ENV=development

# Required to activate the hardcoded admin@sanctions.com / 123456 dev login
# (src/auth/testAccount.ts). Fails closed if unset or not exactly "true" —
# see isTestLoginEnabled(). Also gates the corresponding bypasses in
# src/auth/admins.ts and src/auth/emailAllowlist.ts.
ENABLE_TEST_LOGIN=true

ADMIN_EMAILS=admin@sanctions.com
ALLOWED_EMAIL_DOMAINS=sanctions.com
