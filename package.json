{
  "name": "sanctions-checker",
  "version": "1.0.0",
  "description": "Unified Sanctions List database with importers, REST API, MCP and CLI",
  "main": "dist/api/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "rimraf dist && tsc && node -e \"require('fs').cpSync('src/api/openapi.json', 'dist/api/openapi.json')\"",
    "start": "node dist/api/index.js",
    "dev:api": "nodemon --watch src -e ts --exec ts-node src/api/index.ts",
    "dev:mcp": "ts-node src/mcp/index.ts",
    "cli": "ts-node src/cli/index.ts",
    "import": "ts-node src/importer/index.ts",
    "test": "firebase emulators:exec --only firestore \"vitest run\"",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run tests/unit --coverage --exclude '**/regression-real-data.test.ts'",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/rules\"",
    "test:integration": "firebase emulators:exec --only firestore \"vitest run tests/integration\"",
    "test:watch": "vitest watch tests/unit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "@types/sax": "^1.2.7",
    "axios": "^1.7.4",
    "commander": "^12.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.4.1",
    "firebase-admin": "^12.3.0",
    "firebase-functions": "^7.3.2",
    "fs-extra": "^11.2.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "sax": "^1.6.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.6",
    "@vitest/coverage-v8": "^3.2.7",
    "nodemon": "^3.1.4",
    "rimraf": "^6.0.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7"
  }
}
