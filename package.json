{
  "name": "sanctions-checker",
  "version": "1.0.0",
  "description": "Unified Sanctions List database with importers, REST API, MCP and CLI",
  "main": "dist/api/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/api/index.js",
    "dev:api": "nodemon --watch src -e ts --exec ts-node src/api/index.ts",
    "dev:mcp": "ts-node src/mcp/index.ts",
    "cli": "ts-node src/cli/index.ts",
    "import": "ts-node src/importer/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "axios": "^1.7.4",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.4.1",
    "firebase-admin": "^12.3.0",
    "firebase-functions": "^7.3.2",
    "fs-extra": "^11.2.0",
    "multer": "^2.2.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.4.0",
    "@types/swagger-ui-express": "^4.1.6",
    "nodemon": "^3.1.4",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
