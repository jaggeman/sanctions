{
  "openapi": "3.0.3",
  "info": {
    "title": "Sanktionssök API",
    "description": "REST API för att söka mot konsoliderade sanktionslistor (EU, FN, US OFAC) samt PEP-listor.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Lokal utvecklingsserver"
    }
  ],
  "paths": {
    "/api/search": {
      "get": {
        "summary": "Sök i sanktionslistor",
        "description": "Sök efter personer eller organisationer baserat på namn, alias eller ID i EU:s, FN:s, USA:s och PEP-listor.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Sökord (namn, alias, passnummer)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "Filtrera på källa (t.ex. EU, UN, US, PEP). Separera med kommatecken.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Filtrera på typ",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["individual", "entity", "vessel", "aircraft"]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Max antal träffar (standard 20, max 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "includeDelisted",
            "in": "query",
            "description": "Om 'true', inkludera avlistade (soft-deleted) poster i träfflistan. Standard är att endast visa aktiva poster.",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sökresultat",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SanctionRecord"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Felaktig sökförfrågan (t.ex. saknat sökord)"
          }
        }
      }
    },
    "/api/sanctions/{id}": {
      "get": {
        "summary": "Hämta en specifik sanktionspost",
        "description": "Hämta detaljerad information om en sanktionerad person eller organisation baserat på dess unika ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unikt ID för sanktionsposten (t.ex. EU-1234, US-SDN-999)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Hittad post",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SanctionRecord"
                }
              }
            }
          },
          "404": {
            "description": "Hittade inte posten"
          }
        }
      }
    },
    "/api/import": {
      "post": {
        "summary": "Trigga en uppdatering/import av data",
        "description": "Startar en bakgrundsimport för att ladda ner och uppdatera sanktionslistorna.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["EU", "UN", "US"]
                    }
                  },
                  "csvPath": {
                    "type": "string",
                    "description": "Lokal sökväg till en CSV-fil för PEP/CUSTOM import"
                  },
                  "mode": {
                    "type": "string",
                    "enum": ["sync", "append"],
                    "default": "append",
                    "description": "Issue #8: 'sync' behandlar filen som fullständig sanning för källan och avlistar aktiva poster som saknas i filen. 'append' (standard) avlistar aldrig — rätt för PEP/CUSTOM/kompletterande filer."
                  },
                  "dryRun": {
                    "type": "boolean",
                    "description": "Kör klassificeringen (added/updated/unchanged/delisted) utan att skriva något. Svarar synkront med resultatet istället för 202."
                  },
                  "force": {
                    "type": "boolean",
                    "description": "Kringgå 20%-spärren mot att avlista en for stor andel av en källas aktiva poster."
                  },
                  "importId": {
                    "type": "string",
                    "description": "Valfritt explicit import-ID för versionshistorik; genereras annars automatiskt."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Endast vid dryRun:true — förhandsgranskning med räknare per källa, inget skrivet",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "importedCounts": { "type": "object" },
                    "diffs": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/DiffResult" }
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Import startad i bakgrunden (endast när dryRun inte är satt)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Ogiltiga \"sources\" eller ogiltigt \"mode\""
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DiffResult": {
        "type": "object",
        "description": "Issue #8 — per-source reconciliation result from computeDiff/runDiffForSource.",
        "properties": {
          "source": { "type": "string", "enum": ["EU", "UN", "US", "PEP", "CUSTOM"] },
          "counts": {
            "type": "object",
            "properties": {
              "parsed": { "type": "integer" },
              "added": { "type": "integer" },
              "updated": { "type": "integer" },
              "unchanged": { "type": "integer" },
              "delisted": { "type": "integer" },
              "skipped": { "type": "integer" }
            }
          },
          "toDelistIds": { "type": "array", "items": { "type": "string" } },
          "activeCount": { "type": "integer" },
          "guardTripped": {
            "type": "boolean",
            "description": "true if delisting would exceed 20% of the source's active records without force:true"
          }
        }
      },
      "SanctionRecord": {
        "type": "object",
        "required": ["id", "source", "type", "primaryName", "aliases", "createdAt", "updatedAt"],
        "properties": {
          "id": {
            "type": "string",
            "example": "EU-1234"
          },
          "source": {
            "type": "string",
            "enum": ["EU", "UN", "US", "PEP", "CUSTOM"],
            "example": "EU"
          },
          "type": {
            "type": "string",
            "enum": ["individual", "entity", "vessel", "aircraft"],
            "example": "individual"
          },
          "primaryName": {
            "type": "string",
            "example": "Vladimir Vladimirovich Putin"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["Valodia Putin", "Vladimir Putin"]
          },
          "datesOfBirth": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["1952-10-07"]
          },
          "placesOfBirth": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["Leningrad, USSR"]
          },
          "citizenships": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["Russia"]
          },
          "passports": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["Diplomatic Passport 123456"]
          },
          "addresses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "street": { "type": "string" },
                "city": { "type": "string" },
                "country": { "type": "string" },
                "fullAddress": { "type": "string" }
              }
            }
          },
          "sanctionReason": {
            "type": "string",
            "example": "Involvement in destabilizing Ukraine"
          },
          "legalBasis": {
            "type": "string",
            "example": "Regulation (EU) No 269/2014"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": ["active", "delisted"],
            "description": "Soft-delete status. A missing value should be treated as 'active'.",
            "example": "active"
          },
          "listedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When this record first appeared in an import."
          },
          "delistedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When this record most recently went missing from an import."
          }
        }
      }
    }
  }
}
